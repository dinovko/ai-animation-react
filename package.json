{
  "name": "ai-animation-react",
  "version": "1.0.0",
  "description": "React library that reveals UI as if an AI agent were drawing it: cursor, selection frame, and a clip-path scan.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/styles/agent-reveal.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinovko/ai-animation-react.git"
  },
  "bugs": {
    "url": "https://github.com/dinovko/ai-animation-react/issues"
  },
  "homepage": "https://github.com/dinovko/ai-animation-react#readme",
  "keywords": [
    "react",
    "animation",
    "reveal",
    "clip-path",
    "agent",
    "cursor"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@picocss/pico": "^2.1.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "^5.4.21"
  }
}
